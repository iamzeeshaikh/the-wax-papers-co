  <style>
    .wa-widget {
      position: fixed;
      bottom: 24px;
      left: 24px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    /* Popup */
    .wa-popup {
      width: min(320px, calc(100vw - 2rem));
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 32px rgba(0,0,0,0.18);
      background: #f0f0f0;
      transform: scale(0.92) translateY(12px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.22s ease, transform 0.22s ease;
      transform-origin: bottom left;
    }
    .wa-popup.is-open {
      opacity: 1;
      transform: scale(1) translateY(0);
      pointer-events: auto;
    }

    .wa-popup-header {
      background: #25d366;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 16px;
      color: white;
      font-weight: 700;
      font-size: 1rem;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }
    .wa-popup-logo { width: 28px; height: 28px; flex-shrink: 0; }
    .wa-popup-close {
      margin-left: auto;
      background: rgba(0,0,0,0.2);
      border: none;
      border-radius: 50%;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
    }
    .wa-popup-close svg { width: 16px; height: 16px; }
    .wa-popup-close:hover { background: rgba(0,0,0,0.35); }

    .wa-popup-body { padding: 16px; }
    .wa-message-bubble {
      background: white;
      border-radius: 0 12px 12px 12px;
      padding: 14px 16px;
      font-size: 0.93rem;
      line-height: 1.6;
      color: #111;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    .wa-popup-footer { padding: 4px 16px 16px; }
    .wa-open-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #25d366;
      color: white;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 12px 22px;
      border-radius: 999px;
      text-decoration: none;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      transition: background 0.15s;
    }
    .wa-open-btn svg { width: 20px; height: 20px; }
    .wa-open-btn:hover { background: #1ebe5d; }

    /* Bubble button */
    .wa-bubble {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: #25d366;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(37,211,102,0.45);
      transition: transform 0.2s, box-shadow 0.2s;
      flex-shrink: 0;
    }
    .wa-bubble:hover {
      transform: scale(1.08);
      box-shadow: 0 6px 22px rgba(37,211,102,0.55);
    }
    .wa-bubble svg { width: 32px; height: 32px; }
    .wa-icon-close { display: none; }
    .wa-bubble.is-open .wa-icon-chat { display: none; }
    .wa-bubble.is-open .wa-icon-close { display: block; }

    @media (max-width: 400px) {
      .wa-popup { width: calc(100vw - 32px); }
      .wa-widget { left: 16px; bottom: 16px; }
    }

    /* --- Mobile safety net --------------------------------------------- */
    img, svg, video, iframe, table { max-width: 100%; }
    input, select, textarea, button { max-width: 100%; box-sizing: border-box; }

    @media (max-width: 640px) {
      /* Fields under 16px make iOS zoom the page on focus. */
      input, select, textarea { font-size: 16px; }

      footer a, .breadcrumb a, .footer-contact-item, .quote-contact-item,
      .topbar a, .nav-links a, .prose-link {
        display: inline-block;
        padding-block: 0.3rem;
      }

      .nav-toggle { min-width: 44px; min-height: 44px; }

      table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    }
  </style>

  <script>
    const waBubble = document.getElementById('waBubble');
    const waPopup = document.getElementById('waPopup');
    const waClose = document.getElementById('waClose');

    function openPopup() {
      waPopup?.classList.add('is-open');
      waPopup?.setAttribute('aria-hidden', 'false');
      waBubble?.classList.add('is-open');
      waBubble?.setAttribute('aria-expanded', 'true');
    }
    function closePopup() {
      waPopup?.classList.remove('is-open');
      waPopup?.setAttribute('aria-hidden', 'true');
      waBubble?.classList.remove('is-open');
      waBubble?.setAttribute('aria-expanded', 'false');
    }

    waBubble?.addEventListener('click', () => {
      waPopup?.classList.contains('is-open') ? closePopup() : openPopup();
    });
    waClose?.addEventListener('click', closePopup);

    // Auto-open after 4 seconds on first visit — but only where the panel sits
    // beside the page. On a phone it is 320px wide and lands over the hero CTA,
    // covering roughly half a small screen with something nobody asked for.
    if (!sessionStorage.getItem('wa-seen') && window.matchMedia('(min-width: 768px)').matches) {
      setTimeout(() => {
        openPopup();
        sessionStorage.setItem('wa-seen', '1');
      }, 4000);
    }
  </script>
</body>
</html>
