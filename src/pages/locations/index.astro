---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { locations } from '../../data/locations';

const canonicalUrl = 'https://thewaxpapers.co/locations/';

const regions = ['Northeast', 'Midwest', 'South', 'West'] as const;
const byRegion = regions
  .map(region => ({ region, cities: locations.filter(l => l.region === region) }))
  .filter(group => group.cities.length > 0);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "US Delivery Locations — The Wax Papers",
  "itemListElement": locations.map((l, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `Custom Food Papers in ${l.city}`,
    "url": `https://thewaxpapers.co/locations/${l.slug}/`
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://thewaxpapers.co" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": canonicalUrl }
  ]
};
---

<BaseLayout
  title="US Delivery Locations | Custom Food Papers Across the USA | The Wax Papers"
  description="We deliver custom printed food papers to food businesses across the USA — New York, Los Angeles, Chicago, Houston, Dallas, Miami and more. Find your city."
  canonical={canonicalUrl}
  schema={[itemListSchema, breadcrumbSchema]}
>
  <Fragment slot="navbar"><Navbar /></Fragment>

  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">Locations</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="loc-index-hero">
    <div class="container">
      <span class="section-tag">US Delivery</span>
      <h1 class="loc-index-h1">Custom Food Papers Delivered Across the USA</h1>
      <p class="loc-index-sub">
        From New York delis to LA taco trucks, we print branded, food-safe wrapping papers for food
        businesses in every corner of the country. Choose your city to see how we supply your area —
        or <a href="/get-quote" class="prose-link">get a free quote</a> to get started.
      </p>
    </div>
  </section>

  <!-- Cities by region -->
  <section class="section loc-index-list">
    <div class="container">
      {byRegion.map(group => (
        <div class="loc-nation-block">
          <h2 class="loc-nation-title">{group.region}</h2>
          <div class="loc-index-grid">
            {group.cities.map(city => (
              <a href={`/locations/${city.slug}/`} class="card loc-index-card">
                <div class="loc-index-card-top">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  <h3>{city.city}</h3>
                </div>
                <p>{city.state}</p>
                <span class="related-link">Food papers in {city.city} →</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="product-cta-section">
    <div class="container">
      <div class="product-cta-inner">
        <h2>Don’t See Your City?</h2>
        <p>
          We deliver custom food papers right across the USA — not just the cities listed here.
          Tell us where you’re based and what you serve, and we’ll get you a free quote.
        </p>
        <div class="product-cta-btns">
          <a href="/get-quote" class="btn btn-primary">Get a Free Quote</a>
          <a href="/products" class="btn btn-white">Browse All Products</a>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<style>
  .breadcrumb-bar { background: var(--color-bg-alt); border-bottom: 1px solid var(--color-kraft-light); }

  .loc-index-hero { padding: 3.5rem 0 2rem; background: var(--color-bg); }
  .loc-index-h1 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin: 0.5rem 0 1rem; }
  .loc-index-sub { font-size: 1.05rem; color: var(--color-gray-600); line-height: 1.85; max-width: 760px; }
  .prose-link { color: var(--color-copper); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .prose-link:hover { color: var(--color-brown); }

  .loc-index-list { background: var(--color-white); }
  .loc-nation-block { margin-bottom: 3rem; }
  .loc-nation-block:last-child { margin-bottom: 0; }
  .loc-nation-title {
    font-size: 1.4rem; color: var(--color-brown);
    padding-bottom: 0.6rem; margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-kraft-light);
  }
  .loc-index-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (max-width: 900px) { .loc-index-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .loc-index-grid { grid-template-columns: 1fr; } }
  .loc-index-card { padding: 1.4rem 1.5rem; text-decoration: none; display: flex; flex-direction: column; gap: 0.3rem; }
  .loc-index-card-top { display: flex; align-items: center; gap: 0.5rem; }
  .loc-index-card-top svg { color: var(--color-copper); flex-shrink: 0; }
  .loc-index-card-top h3 { font-size: 1.1rem; color: var(--color-brown); }
  .loc-index-card p { font-size: 0.83rem; color: var(--color-gray-600); margin-bottom: 0.5rem; }
  .loc-index-card .related-link { font-size: 0.85rem; font-weight: 600; color: var(--color-copper); margin-top: auto; }
  .loc-index-card:hover .related-link { text-decoration: underline; }

  .product-cta-section { padding: 4rem 0; background: linear-gradient(135deg, #1a3322, #3d6b4f); }
  .product-cta-inner { text-align: center; color: var(--color-white); max-width: 680px; margin: 0 auto; }
  .product-cta-inner h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--color-white); margin-bottom: 1rem; }
  .product-cta-inner p { font-size: 0.97rem; color: rgba(255,255,255,0.8); line-height: 1.75; margin-bottom: 1.75rem; }
  .product-cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
</style>
