---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { locations, getLocationBySlug, getNearbyLocations } from '../../data/locations';
import { getProductBySlug } from '../../data/products';

export async function getStaticPaths() {
  return locations.map(l => ({ params: { slug: l.slug } }));
}

const { slug } = Astro.params;
const loc = getLocationBySlug(slug as string);
if (!loc) return Astro.redirect('/locations');

const featured = loc.featuredProducts
  .map(s => getProductBySlug(s))
  .filter(Boolean) as NonNullable<ReturnType<typeof getProductBySlug>>[];
const nearby = getNearbyLocations(loc.nearbyCities);
const canonicalUrl = `https://thewaxpapers.co/locations/${loc.slug}/`;

// Per-slug heading rotation so no two city pages share identical section
// headings, on top of each city's unique prose fields.
const seed = loc.slug.split('').reduce((s, c) => s + c.charCodeAt(0), 0);
const pick = (arr: string[], offset = 0) => arr[(seed + offset) % arr.length];

const answerHeading = pick([
  `Custom Food Papers in ${loc.city}`,
  `Branded Food Paper Supply for ${loc.city}`,
  `Printed Food Wrapping for ${loc.city} Businesses`,
]);
const industriesHeading = pick([
  `Who We Supply in ${loc.city}`,
  `${loc.city} Food Businesses We Print For`,
  `Trades We Serve Across ${loc.city}`,
], 1);
const whyHeading = pick([
  `Why ${loc.city} Kitchens Choose The Wax Papers`,
  `What Sets Our ${loc.city} Service Apart`,
  `The ${loc.city} Trader’s Packaging Partner`,
], 2);
const deliveryHeading = pick([
  `Delivery Across ${loc.city} & Beyond`,
  `Getting Your Order to ${loc.city}`,
  `${loc.city} Delivery & Lead Times`,
], 1);

const firstFaqQ = `Do you deliver custom food papers to ${loc.city}?`;
const faqs = [
  { q: firstFaqQ, a: loc.faqCityAnswer },
  { q: `What’s the minimum order for ${loc.city} businesses?`, a: `Our minimum order starts at 500 sheets, which keeps custom printing accessible for independent ${loc.city} traders and small kitchens — not just large groups. There are no hidden setup fees on standard orders.` },
  { q: `Can I print my logo and brand colours on the paper?`, a: `Absolutely. Every order is printed to your artwork — logo, brand colours, or a full-sheet design — using food-safe inks. We send a free digital proof for approval before anything goes to print.` },
  { q: `Are your food papers safe for direct food contact?`, a: `Yes. All our papers are made from food-safe, grease-resistant materials and printed with food-grade inks suitable for direct contact with hot and cold food.` },
  { q: `How long does production and delivery take?`, a: `Standard production runs 8–12 business days after artwork approval, then your order is dispatched to ${loc.city}. If you have an event or opening deadline, tell us and we’ll confirm timings up front.` },
  { q: `Do you supply both single sites and multi-site groups in ${loc.city}?`, a: `Both. We print to order and store your design for consistent reorders, so whether you run one ${loc.city} pitch or several sites, your branding stays identical across every location.` },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Custom Printed Food Papers — ${loc.city}`,
  "serviceType": "Custom printed food packaging paper supply",
  "description": loc.metaDescription,
  "url": canonicalUrl,
  "provider": { "@id": "https://thewaxpapers.co/#organization" },
  "areaServed": {
    "@type": "City",
    "name": loc.city,
    "containedInPlace": { "@type": "AdministrativeArea", "name": `${loc.county}, ${loc.nation}` }
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `Custom Food Papers for ${loc.city}`,
    "itemListElement": featured.map(p => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Product", "name": p.title, "url": `https://thewaxpapers.co/products/${p.slug}/` }
    }))
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://thewaxpapers.co" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://thewaxpapers.co/locations" },
    { "@type": "ListItem", "position": 3, "name": loc.city, "item": canonicalUrl }
  ]
};
---

<BaseLayout
  title={loc.metaTitle}
  description={loc.metaDescription}
  canonical={canonicalUrl}
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <Fragment slot="navbar"><Navbar /></Fragment>

  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/locations">Locations</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{loc.city}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="loc-hero">
    <div class="container loc-hero-inner">
      <div class="loc-hero-text">
        <span class="section-tag">{loc.county} · {loc.nation}</span>
        <h1 class="loc-h1">{loc.h1}</h1>
        <p class="loc-intro">{loc.intro}</p>
        <div class="loc-hero-ctas">
          <a href="/get-quote" class="btn btn-primary">Get a Free Quote</a>
          <a href="/products" class="btn btn-outline">Browse All Products</a>
        </div>
      </div>
      <div class="loc-hero-card">
        <div class="loc-stat">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>{loc.stat}</span>
        </div>
        <ul class="loc-hero-list">
          <li><span aria-hidden="true">✓</span> Printed to your logo &amp; brand colours</li>
          <li><span aria-hidden="true">✓</span> Food-safe, grease-resistant papers</li>
          <li><span aria-hidden="true">✓</span> Delivered across {loc.city}</li>
          <li><span aria-hidden="true">✓</span> Free digital proof · low minimums</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Answer-first -->
  <section class="section loc-answer">
    <div class="container">
      <h2 class="loc-answer-h2">{answerHeading}</h2>
      <p>
        The Wax Papers prints custom, food-safe wrapping papers for restaurants, takeaways, cafes and street-food traders across {loc.city} and {loc.county}. Every sheet is produced to your artwork with food-grade inks, so your branding travels with the food from the counter to the customer. Popular choices for {loc.city} kitchens include our <a href={`/products/${featured[0].slug}/`} class="prose-link">{featured[0].title.toLowerCase()}</a>, printed to order and dispatched on a schedule that keeps up with local demand.
      </p>
      <p class="loc-keyfacts">
        <strong>Key facts:</strong> Minimum order 500 sheets · Printed to your design · Free digital proof · No setup fees on standard orders · Delivered throughout {loc.city}.
      </p>
    </div>
  </section>

  <!-- Local scene (unique per city) -->
  <section class="section loc-scene alt-bg">
    <div class="container loc-scene-inner">
      <div class="loc-scene-text">
        <span class="section-tag">On the Ground in {loc.city}</span>
        <h2>{loc.sceneHeading}</h2>
        <p>{loc.localScene}</p>
        <p>
          Whatever you serve — from {loc.signatureDish} to a full weekend menu — the right wrap keeps it looking sharp. Our <a href={`/products/${featured[1].slug}/`} class="prose-link">{featured[1].title.toLowerCase()}</a> are a natural fit for the way {loc.city} eats.
        </p>
      </div>
      <div class="loc-scene-districts">
        <h3>Areas We Serve in {loc.city}</h3>
        <div class="district-tags">
          {loc.districts.map(d => <span class="district-tag">{d}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Industries served -->
  <section class="section loc-industries">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Who It’s For</span>
        <h2 class="section-title">{industriesHeading}</h2>
        <p class="section-subtitle">
          We print for the full range of {loc.city} food businesses — and match the paper to the job. If you’re not sure which stock suits your menu, our <a href={`/products/${featured[2].slug}/`} class="prose-link">{featured[2].title.toLowerCase()}</a> are a popular starting point.
        </p>
      </div>
      <div class="loc-industry-grid">
        {loc.industries.map(ind => (
          <div class="loc-industry-item">
            <span class="loc-industry-check" aria-hidden="true">✓</span>
            {ind}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured products grid (navigational) -->
  <section class="section loc-products alt-bg">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Popular in {loc.city}</span>
        <h2 class="section-title">Food Papers {loc.city} Businesses Order Most</h2>
      </div>
      <div class="related-grid">
        {featured.map(p => (
          <a href={`/products/${p.slug}/`} class="card related-card" aria-label={`View ${p.title}`}>
            <div class="related-card-img">
              <img src={p.heroImage} alt={`${p.title} for ${loc.city} food businesses`} loading="lazy" width="320" height="200" />
            </div>
            <div class="related-card-body">
              <h3>{p.title}</h3>
              <p>{p.intro.slice(0, 85)}…</p>
              <span class="related-link">View {p.title} →</span>
            </div>
          </a>
        ))}
      </div>
      <div class="related-all-link">
        <a href="/products/">Browse All 25 Custom Food Papers →</a>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section loc-why">
    <div class="container loc-why-inner">
      <div class="loc-why-text">
        <span class="section-tag">Why Us</span>
        <h2>{whyHeading}</h2>
        <p>
          Big-brand polish shouldn’t need a big-brand budget. We print to order with food-safe inks, keep minimums low, and store your artwork so reorders match every time — the practical support a busy {loc.city} kitchen actually needs.
        </p>
        <ul class="loc-why-list">
          <li>✓ Low 500-sheet minimums for independents</li>
          <li>✓ Free digital proof before every print run</li>
          <li>✓ Consistent branding across multiple sites</li>
          <li>✓ Grease-resistant stocks for real service conditions</li>
        </ul>
        <a href="/get-quote" class="btn btn-primary">Start Your {loc.city} Quote</a>
      </div>
      <div class="loc-why-aside">
        <h3>{deliveryHeading}</h3>
        <p>{loc.deliveryNote}</p>
      </div>
    </div>
  </section>

  <!-- Nearby cities (navigational) -->
  {nearby.length > 0 && (
    <section class="section loc-nearby alt-bg">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Also Serving</span>
          <h2 class="section-title">Custom Food Papers in Nearby Cities</h2>
        </div>
        <div class="loc-nearby-grid">
          {nearby.map(n => (
            <a href={`/locations/${n.slug}/`} class="card loc-nearby-card">
              <h3>{n.city}</h3>
              <span class="loc-nearby-county">{n.county} · {n.nation}</span>
              <span class="related-link">Food papers in {n.city} →</span>
            </a>
          ))}
        </div>
        <div class="related-all-link">
          <a href="/locations/">View All UK Delivery Locations →</a>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section faq-section-product">
    <div class="container">
      <div class="faq-product-inner">
        <div>
          <span class="section-tag">FAQs</span>
          <h2 class="section-title">{loc.city} Food Paper — FAQs</h2>
          <p class="section-subtitle">Common questions from {loc.city} food businesses before ordering.</p>
        </div>
        <div class="faq-list" style="border-top: 1px solid var(--color-gray-200)">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <div class="faq-body">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="product-cta-section">
    <div class="container">
      <div class="product-cta-inner">
        <h2>Ready to Order Custom Food Papers in {loc.city}?</h2>
        <p>
          Get a free, no-obligation quote for your {loc.city} order. We’ll confirm your specifications, review your artwork, and get your branded papers into production quickly.
        </p>
        <div class="product-cta-btns">
          <a href="/get-quote" class="btn btn-primary">Get a Free Quote</a>
          <a href="/contact" class="btn btn-white">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<style>
  .breadcrumb-bar { background: var(--color-bg-alt); border-bottom: 1px solid var(--color-kraft-light); }

  .loc-hero { padding: 3.5rem 0; background: var(--color-bg); }
  .loc-hero-inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3.5rem; align-items: center; }
  @media (max-width: 900px) { .loc-hero-inner { grid-template-columns: 1fr; gap: 2rem; } }
  .loc-h1 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 0.5rem 0 1rem; }
  .loc-intro { font-size: 1.02rem; color: var(--color-gray-600); line-height: 1.85; margin-bottom: 1.5rem; }
  .loc-hero-ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .loc-hero-card {
    background: var(--color-white);
    border: 1px solid var(--color-kraft-light);
    border-radius: var(--radius);
    padding: 1.75rem;
    box-shadow: var(--shadow-md);
  }
  .loc-stat {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-display); font-weight: 700; color: var(--color-brown);
    font-size: 1.05rem; line-height: 1.3;
    padding-bottom: 1rem; margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-gray-100);
  }
  .loc-stat svg { color: var(--color-copper); flex-shrink: 0; }
  .loc-hero-list { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .loc-hero-list li { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.9rem; color: var(--color-gray-700); }
  .loc-hero-list span { color: var(--color-copper); font-weight: 700; }

  .loc-answer { background: var(--color-white); }
  .loc-answer-h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 1.25rem; }
  .loc-answer p { font-size: 0.98rem; color: var(--color-gray-700); line-height: 1.85; margin-bottom: 1rem; max-width: 900px; }
  .loc-keyfacts { color: var(--color-gray-600) !important; }
  .loc-answer strong { color: var(--color-brown); }

  .alt-bg { background: var(--color-bg-alt); }
  .loc-scene-inner { display: grid; grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: start; }
  @media (max-width: 900px) { .loc-scene-inner { grid-template-columns: 1fr; gap: 2rem; } }
  .loc-scene-text h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin: 0.5rem 0 1rem; }
  .loc-scene-text p { font-size: 0.97rem; color: var(--color-gray-700); line-height: 1.85; margin-bottom: 1rem; }
  .loc-scene-districts h3 { font-size: 1.05rem; color: var(--color-brown); margin-bottom: 1rem; }
  .district-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .district-tag {
    padding: 0.35rem 0.85rem; border-radius: 999px; font-size: 0.82rem; font-weight: 500;
    background: var(--color-white); color: var(--color-brown); border: 1px solid var(--color-kraft-light);
  }

  .loc-industries { background: var(--color-white); }
  .loc-industry-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (max-width: 900px) { .loc-industry-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .loc-industry-grid { grid-template-columns: 1fr; } }
  .loc-industry-item {
    display: flex; align-items: flex-start; gap: 0.6rem;
    background: var(--color-bg-alt); border-radius: var(--radius-sm);
    padding: 1rem 1.15rem; font-size: 0.92rem; color: var(--color-gray-700);
    border: 1px solid var(--color-kraft-light);
  }
  .loc-industry-check { color: var(--color-copper); font-weight: 700; flex-shrink: 0; }

  .prose-link { color: var(--color-copper); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .prose-link:hover { color: var(--color-brown); }

  .loc-why-inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3.5rem; align-items: start; }
  @media (max-width: 900px) { .loc-why-inner { grid-template-columns: 1fr; gap: 2rem; } }
  .loc-why-text h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin: 0.5rem 0 1rem; }
  .loc-why-text p { font-size: 0.97rem; color: var(--color-gray-600); line-height: 1.8; margin-bottom: 1.25rem; }
  .loc-why-list { list-style: none; display: flex; flex-direction: column; gap: 0.55rem; margin-bottom: 1.5rem; }
  .loc-why-list li { font-size: 0.92rem; color: var(--color-gray-700); }
  .loc-why-aside {
    background: var(--color-bg-alt); border-radius: var(--radius); padding: 1.75rem;
    border: 1px solid var(--color-kraft-light);
  }
  .loc-why-aside h3 { font-size: 1.15rem; color: var(--color-brown); margin-bottom: 0.85rem; }
  .loc-why-aside p { font-size: 0.92rem; color: var(--color-gray-600); line-height: 1.8; }

  .loc-nearby-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  @media (max-width: 800px) { .loc-nearby-grid { grid-template-columns: 1fr; } }
  .loc-nearby-card {
    padding: 1.4rem 1.5rem; text-decoration: none;
    display: flex; flex-direction: column; gap: 0.35rem;
  }
  .loc-nearby-card h3 { font-size: 1.15rem; color: var(--color-brown); }
  .loc-nearby-county { font-size: 0.82rem; color: var(--color-gray-600); margin-bottom: 0.4rem; }
  .loc-nearby-card .related-link { font-size: 0.85rem; font-weight: 600; color: var(--color-copper); }
  .loc-nearby-card:hover .related-link { text-decoration: underline; }

  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  @media (max-width: 900px) { .related-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .related-grid { grid-template-columns: 1fr; } }
  .related-card { text-decoration: none; }
  .related-card-img img { width: 100%; height: 180px; object-fit: cover; }
  .related-card-body { padding: 1.1rem; }
  .related-card-body h3 { font-size: 1rem; color: var(--color-brown); margin-bottom: 0.4rem; }
  .related-card-body p { font-size: 0.83rem; color: var(--color-gray-600); margin-bottom: 0.6rem; line-height: 1.6; }
  .related-link { font-size: 0.83rem; font-weight: 600; color: var(--color-copper); }
  .related-all-link { margin-top: 1.5rem; text-align: center; }
  .related-all-link a { font-size: 0.9rem; color: var(--color-copper); font-weight: 600; }
  .related-all-link a:hover { text-decoration: underline; }

  .faq-section-product { background: var(--color-white); }
  .faq-product-inner { display: grid; grid-template-columns: 1fr 1.6fr; gap: 4rem; align-items: start; }
  @media (max-width: 900px) { .faq-product-inner { grid-template-columns: 1fr; gap: 2rem; } }

  .product-cta-section { padding: 4rem 0; background: linear-gradient(135deg, #1a3322, #3d6b4f); }
  .product-cta-inner { text-align: center; color: var(--color-white); max-width: 680px; margin: 0 auto; }
  .product-cta-inner h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--color-white); margin-bottom: 1rem; }
  .product-cta-inner p { font-size: 0.97rem; color: rgba(255,255,255,0.8); line-height: 1.75; margin-bottom: 1.75rem; }
  .product-cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
</style>
