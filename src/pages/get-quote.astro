---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data/products';
---

<BaseLayout
  title="Get a Free Custom Food Papers Quote | The Wax Papers USA"
  description="Request a free no-obligation quote for custom wax papers, greaseproof papers, deli papers, burger papers & food packaging. Response within 1 business day. Ships all 50 states."
  canonical="https://thewaxpapers.co/get-quote"
>
  <Fragment slot="navbar"><Navbar /></Fragment>

  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">Get a Free Quote</span>
      </nav>
    </div>
  </div>

  <section class="quote-hero">
    <div class="container">
      <span class="section-tag">No Obligation</span>
      <h1 class="quote-h1">Get a Free Custom Food Paper Quote</h1>
      <p class="quote-intro">
        Fill out the form below and our team will get back to you within one business day with pricing, lead times, and specifications tailored to your order.
      </p>
    </div>
  </section>

  <section class="quote-section">
    <div class="container">
      <div class="quote-layout">
        <div class="quote-form-wrap">
          <form name="quote-request" method="POST" class="quote-form" enctype="multipart/form-data" aria-label="Quote request form">
            <!-- Honeypot spam trap -->
            <div class="hp-field" aria-hidden="true">
              <label for="hp-website">Website</label>
              <input type="text" id="hp-website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="name">Full Name <span aria-hidden="true">*</span></label>
                <input class="form-control" type="text" id="name" name="name" required autocomplete="name" placeholder="Your full name" />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">Email Address <span aria-hidden="true">*</span></label>
                <input class="form-control" type="email" id="email" name="email" required autocomplete="email" placeholder="your@email.com" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="phone">Phone Number</label>
                <input class="form-control" type="tel" id="phone" name="phone" autocomplete="tel" placeholder="(555) 000-0000" />
              </div>
              <div class="form-group">
                <label class="form-label" for="company">Company Name</label>
                <input class="form-control" type="text" id="company" name="company" autocomplete="organization" placeholder="Your restaurant or business name" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="product">Product Type <span aria-hidden="true">*</span></label>
                <select class="form-control" id="product" name="product" required>
                  <option value="" disabled selected>Select a product</option>
                  {products.map(p => (
                    <option value={p.slug}>{p.title}</option>
                  ))}
                  <option value="other">Other / Multiple Products</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="quantity">Estimated Quantity <span aria-hidden="true">*</span></label>
                <select class="form-control" id="quantity" name="quantity" required>
                  <option value="" disabled selected>Select quantity</option>
                  <option value="500-999">500 – 999 sheets</option>
                  <option value="1000-4999">1,000 – 4,999 sheets</option>
                  <option value="5000-9999">5,000 – 9,999 sheets</option>
                  <option value="10000-24999">10,000 – 24,999 sheets</option>
                  <option value="25000+">25,000+ sheets</option>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="size">Sheet Size</label>
                <input class="form-control" type="text" id="size" name="size" placeholder='e.g. 12x12", 14x14" or custom' />
              </div>
              <div class="form-group">
                <label class="form-label" for="printing">Printing Requirement</label>
                <select class="form-control" id="printing" name="printing">
                  <option value="" disabled selected>Select print type</option>
                  <option value="single-color">Single-Color Logo</option>
                  <option value="2-color">2-Color Print</option>
                  <option value="full-color">Full-Color CMYK</option>
                  <option value="all-over">All-Over Pattern</option>
                  <option value="no-print">No Print / Plain</option>
                  <option value="unsure">Not Sure Yet</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="artwork">Upload Artwork (optional)</label>
              <div class="file-upload-area">
                <input class="form-control file-input" type="file" id="artwork" name="artwork" accept=".ai,.eps,.pdf,.png,.jpg,.svg" aria-describedby="artwork-hint" />
                <p id="artwork-hint" class="form-hint">Accepted formats: AI, EPS, PDF, PNG, JPG. Max 20MB. You can also send artwork by email after submitting.</p>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="message">Additional Details or Questions</label>
              <textarea class="form-control" id="message" name="message" rows="4" placeholder="Tell us more about your requirements, special sizes, deadlines, or any questions you have..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary quote-submit">Submit Quote Request</button>
            <p class="form-privacy">Your information is kept private and never shared. We will respond within 1 business day.</p>
          </form>
        </div>

        <!-- Sidebar info -->
        <aside class="quote-sidebar">
          <div class="quote-info-card">
            <h3>Why Get a Quote?</h3>
            <ul class="quote-benefits-list">
              <li>✓ Free, no-obligation pricing</li>
              <li>✓ Response within 1 business day</li>
              <li>✓ Custom sizing available</li>
              <li>✓ Bulk wholesale discounts</li>
              <li>✓ Full-color printing options</li>
              <li>✓ FDA-compliant materials confirmed</li>
            </ul>
          </div>

          <div class="quote-info-card">
            <h3>Contact Us Directly</h3>
            <div class="quote-contact-list">
              <a href="tel:+15033580443" class="quote-contact-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013 10.18a19.79 19.79 0 01-3.07-8.67A2 2 0 011.9 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                (503) 358-0443
              </a>
              <a href="mailto:info@thewaxpapers.co" class="quote-contact-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                info@thewaxpapers.co
              </a>
            </div>
          </div>

          <div class="quote-info-card">
            <h3>Minimum Orders</h3>
            <p>500 sheets minimum for most products. No setup fees for artwork review. Volume discounts from 2,000 sheets.</p>
          </div>

          <div class="quote-info-card">
            <h3>Lead Times</h3>
            <p>8–12 business days from artwork approval. Rush production available depending on schedule.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<style>
  .breadcrumb-bar { background: var(--color-bg-alt); border-bottom: 1px solid var(--color-kraft-light); }

  .quote-hero {
    padding: 3.5rem 0 2.5rem;
    background: linear-gradient(135deg, #1a3322, #2d5c3e);
    color: var(--color-white);
  }
  .quote-hero .section-tag { background: rgba(74,124,89,0.3); color: var(--color-kraft-light); }
  .quote-h1 { font-size: clamp(1.8rem, 3.5vw, 2.5rem); color: var(--color-white); margin: 0.75rem 0 1rem; }
  .quote-intro { font-size: 1.05rem; color: rgba(255,255,255,0.8); max-width: 580px; line-height: 1.75; }

  .quote-section { padding: 4rem 0 5rem; background: var(--color-bg); }
  .quote-layout { display: grid; grid-template-columns: 1fr 280px; gap: 4rem; align-items: start; }
  @media (max-width: 1000px) { .quote-layout { grid-template-columns: 1fr; } }

  .quote-form { background: var(--color-white); border-radius: var(--radius); padding: 2.5rem; box-shadow: var(--shadow-md); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }

  .file-input { padding: 0.5rem; cursor: pointer; }
  .form-hint { font-size: 0.8rem; color: var(--color-gray-600); margin-top: 0.4rem; }

  .quote-submit { width: 100%; justify-content: center; font-size: 1rem; padding: 0.9rem; margin-top: 0.5rem; }
  .form-privacy { font-size: 0.78rem; color: var(--color-gray-600); text-align: center; margin-top: 0.75rem; }

  .quote-sidebar { display: flex; flex-direction: column; gap: 1.25rem; position: sticky; top: 90px; }
  @media (max-width: 1000px) { .quote-sidebar { position: static; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; } }
  @media (max-width: 600px) { .quote-sidebar { grid-template-columns: 1fr; } }

  .quote-info-card {
    background: var(--color-white);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .quote-info-card h3 { font-size: 0.97rem; color: var(--color-brown); margin-bottom: 0.75rem; }
  .quote-info-card p { font-size: 0.87rem; color: var(--color-gray-600); line-height: 1.65; }

  .quote-benefits-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .quote-benefits-list li { font-size: 0.87rem; color: var(--color-gray-700); }

  .quote-contact-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .quote-contact-item {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.9rem; color: var(--color-copper); font-weight: 500;
  }
  .quote-contact-item:hover { text-decoration: underline; }
</style>
