{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://chat.zeeops.dev; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.typekit.net; font-src 'self' https://fonts.gstatic.com https://*.typekit.net; img-src 'self' data: blob: https:; connect-src 'self' https://chat.zeeops.dev; frame-ancestors 'none';" }
      ]
    }
  ],
  "redirects": [
    { "source": "/home/", "destination": "/", "permanent": true },
    { "source": "/quote/", "destination": "/get-quote/", "permanent": true },
    { "source": "/products/wax-paper/", "destination": "/products/custom-food-papers/", "permanent": true },
    { "source": "/products/bagel-paper/", "destination": "/products/bagel-papers/", "permanent": true },
    { "source": "/products/christmas-wrapping-paper/", "destination": "/products/christmas-wrapping-papers/", "permanent": true },
    { "source": "/products/coffee-sleeve/", "destination": "/products/coffee-sleeves/", "permanent": true },
    { "source": "/products/custom-burger-paper/", "destination": "/products/custom-burger-papers/", "permanent": true },
    { "source": "/products/custom-butcher-paper/", "destination": "/products/custom-butcher-papers/", "permanent": true },
    { "source": "/products/custom-butter-paper/", "destination": "/products/custom-butter-papers/", "permanent": true },
    { "source": "/products/custom-cheese-paper/", "destination": "/products/custom-cheese-papers/", "permanent": true },
    { "source": "/products/custom-deli-paper/", "destination": "/products/custom-deli-papers/", "permanent": true },
    { "source": "/products/custom-fish-and-chip-paper/", "destination": "/products/custom-fish-and-chip-papers/", "permanent": true },
    { "source": "/products/custom-food-paper/", "destination": "/products/custom-food-papers/", "permanent": true },
    { "source": "/products/custom-freezer-paper/", "destination": "/products/custom-freezer-papers/", "permanent": true },
    { "source": "/products/custom-fry-paper/", "destination": "/products/custom-fry-papers/", "permanent": true },
    { "source": "/products/custom-greaseproof-paper/", "destination": "/products/custom-greaseproof-papers/", "permanent": true },
    { "source": "/products/custom-heat-seal-paper/", "destination": "/products/custom-heat-seal-papers/", "permanent": true },
    { "source": "/products/custom-hot-paper/", "destination": "/products/custom-hot-papers/", "permanent": true },
    { "source": "/products/custom-kraft-paper/", "destination": "/products/custom-kraft-papers/", "permanent": true },
    { "source": "/products/custom-pizza-liner/", "destination": "/products/custom-pizza-liners/", "permanent": true },
    { "source": "/products/custom-printed-tissue-paper/", "destination": "/products/custom-printed-tissue-papers/", "permanent": true },
    { "source": "/products/custom-sandwich-paper/", "destination": "/products/custom-sandwich-papers/", "permanent": true },
    { "source": "/products/custom-wrapping-paper/", "destination": "/products/custom-wrapping-papers/", "permanent": true },
    { "source": "/products/glassine-paper/", "destination": "/products/glassine-papers/", "permanent": true },
    { "source": "/products/parchment-paper/", "destination": "/products/parchment-papers/", "permanent": true },
    { "source": "/products/taco-wrapping-paper/", "destination": "/products/taco-wrapping-papers/", "permanent": true }
  ],
  "cleanUrls": true,
  "trailingSlash": true
}
